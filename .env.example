# Copy this file to .env (same folder) and paste your key.
# .env is in .gitignore, so the key never ends up on GitHub.

# Key from the TypeSafe console (https://console.typesafe.ai/keys):
TYPESAFE_API_KEY=paste-your-typesafe-key-here

# Or, if you use Jev through OpenRouter instead, delete the line above and use:
# OPENROUTER_API_KEY=sk-or-v1-paste-your-key-here
